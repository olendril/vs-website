{
	"code": "claytilesslab",
	"__comment": "This block class removes the bottom snow section from vertically standing slabs when there is no ground below",
	"class": "BlockSlabSnowRemove",
	"behaviors": [
		{ "name": "OmniRotatable", "properties": { "rotateSides": true, "facing": "block" } },
		{ "name": "WrenchOrientable", "properties": { "baseCode": "bricklayers:claytilesslab-{edge}-{color}-*-{cover}" } }
	],
	"variantgroups": [
		{ "code": "edge", "states": [ "dull", "polished" ] },
		{ "code": "color", "states": [ "black", "blurple", "blue", "brown", "darkgrey", "fire", "red", "green", "light", "pink", "purple", "malachite", "orange", "yellow", "lavender", "paleblue", "palegreen", "palered", "peach", "sunflower", "white" ] },
		{ "code": "rot", "states": [ "north", "east", "south", "west", "up", "down" ] },
		{ "code": "cover", "states": [ "free", "snow" ] }
	],
	"skipVariants": [ "*-up-snow" ],
	"attributes": {
		"canChisel": true,
		"chiselShapeFromCollisionBox": true,
		"handbook": {
			"groupBy": [ "claytilesslab-*" ]
		},
		"liquidBarrierOnSidesByType": {
			"*-down-*": [ 0.5, 0.5, 0.5, 0.5 ]
		},
		"mapColorCode": "settlement",
		"partialAttachableByType": {
			"*-down-*": true,
			"*-up-*": true
		}
	},
	"replaceable": 700,
	"resistance": 2,
	"creativeinventory": { "general": [ "*-down-free" ], "construction": [ "*-down-free" ] },
	"drops": [ { "code": "bricklayers:claytilesslab-{edge}-{color}-down-free" } ],
	"shapeByType": {
		"*-snow": { "base": "game:block/basic/slab/snow-slab-{rot}" },
		"*": { "base": "game:block/basic/slab/slab-{rot}" }
	},
	"texturesByType": {
		"@.*-dull-(lavender|paleblue|palegreen|palered|peach|sunflower|white)-.*": {
			"all": { "base": "bricklayers:block/clay/burnt/{color}", "alternates": [ { "base": "bricklayers:block/clay/burnt/{color}1" } ] }
		},
		"@.*-polished-(lavender|paleblue|palegreen|palered|peach|sunflower|white)-.*": {
			"all": { "base": "bricklayers:block/clay/burnt/{color}", "overlays": [ "bricklayers:block/ceramic/overlay_tile" ],
				"alternates": [ { "base": "bricklayers:block/clay/burnt/{color}1", "overlays": [ "bricklayers:block/ceramic/overlay_tile" ] } ]
			}
		},
		"*-dull-*": {
			"all": { "base": "bricklayers:block/clay/hardened/{color}1", "blendedOverlays": [ { "base": "bricklayers:block/ceramic/overlay_hardened", "blendMode": "Overlay" } ],
		       		"alternates": [ { "base": "bricklayers:block/clay/hardened/{color}2", "blendedOverlays": [ { "base": "bricklayers:block/ceramic/overlay_hardened", "blendMode": "Overlay" } ] } ] }
		},
		"*": {
			"all": { "base": "bricklayers:block/clay/hardened/{color}1", "overlays": [ "bricklayers:block/ceramic/overlay_tile" ],
				"alternates": [ { "base": "bricklayers:block/clay/hardened/{color}2", "overlays": [ "bricklayers:block/ceramic/overlay_tile" ] } ]
			}
		}
	},
	"sideSolidOpaqueAoByType": {
		"*-north-*": { "all": false, "north": true },
		"*-east-*": { "all": false, "east": true },
		"*-south-*": { "all": false, "south": true },
		"*-west-*": { "all": false, "west": true },
		"*-up-*": { "all": false, "up": true },
		"*-down-*": { "all": false, "down": true }
	},
	"sideAo": { "all": true },
	"emitSideAoByType": {
		"*-up-*": { "all": false, "up": true },
		"*-down-*": { "all": false, "down": true },
		"*": { "all": false }
	},
	"collisionbox": { "x1": 0, "y1": 0, "z1": 0, "x2": 1, "y2": 0.5, "z2": 1,
		"rotateXByType": {
			"*-north-*": 90,
			"*-south-*": 270,
			"*-up-*": 180,
			"*-down-*": 0
		},
		"rotateZByType": {
			"*-east-*": 90,
			"*-west-*": 270
		}
	},
	"selectionbox": { "x1": 0, "y1": 0, "z1": 0, "x2": 1, "y2": 0.5, "z2": 1,
		"rotateXByType": {
			"*-north-*": 90,
			"*-south-*": 270,
			"*-up-*": 180,
			"*-down-*": 0
		},
		"rotateZByType": {
			"*-east-*": 90,
			"*-west-*": 270
		}
	},
	"sounds": {
		"walk": "game:walk/stone",
		"byTool": {
			"Pickaxe": { "hit": "game:block/rock-hit-pickaxe", "break": "game:block/rock-break-pickaxe" }
		}
	},
	"guiTransform": {
		"translation": { "x": 0, "y": 2, "z": 0 },
		"origin": { "x": 0.5, "y": 0.25, "z": 0.5 }
	},
	"heldTpIdleAnimation": "holdbothhandslarge", "heldTpUseAnimation": "twohandplaceblock",
	"tpHandTransform": {
		"translation": { "x": -1.2, "y": -1.1, "z": -0.8 },
		"rotation": { "x": -2, "y": 25, "z": -78 },
		"scale": 0.37
	}
}
