		"*-north-*":	{ "base": "game:block/roofing/main/shingles-clay-{cover}", "rotateY": 90 },
		"*-west-*":	{ "base": "game:block/roofing/main/shingles-clay-{cover}", "rotateY": 180 },
		"*-south-*":	{ "base": "game:block/roofing/main/shingles-clay-{cover}", "rotateY": 270 },
		"*-east-*":	{ "base": "game:block/roofing/main/shingles-clay-{cover}", "rotateY": 0 }
	},
	"texturesByType": {
		"*": { "material": { "base": "bricklayers:block/clay/shingles/{material}" } }
        },
	"blockmaterialByType": {
		"*": "Ceramic"
	},
	"creativeinventory": { "general": [ "*-east-free" ], "decorative": [ "*-east-free" ], "ceramics": [ "*-east-free" ] },
	"soundsbyType": {
		"*": { "walk": "game:walk/stone", "place": "game:block/ceramicplace" }
	}
}
