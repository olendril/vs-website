{
	"inheritFrom": "game:blocktypes/roofing/slantedroofing.json",
	"code": "slantedroofing",
	"variantgroups": [
		{ "code": "material", "states": [ "malachite", "green", "blurple", "purple" ] },
		{ "loadFromProperties": "game:abstract/horizontalorientation" },
                { "code": "cover", "states": [ "free", "snow" ] }
	],
	"behaviors": [ { "name": "HorizontalOrientable", "properties": {  "dropBlockFace": "east", "drop": { "type": "block", "code": "bricklayers:slantedroofing-{material}-east-free" } } } ],
