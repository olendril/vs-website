[
  // ── IME Muck Drop Table — Vanilla Stone Blocks ───────────────────────────
  // All vanilla Vintage Story rock types that should produce stone muck when
  // broken. Stone blocks produce only stone layers (no oreCode).
  //
  // stoneCode is set explicitly so the composition correctly identifies the
  // rock type (e.g. "game:rock-granite") rather than using the full block
  // variant code. This matters for machine processing — a Shaker Table
  // processing granite muck vs. limestone muck may behave differently.
  //
  // Layer counts (Design Doc §2.2): Stone = 5±1 layers per block.
  // Cracked stone = 3±1 (slightly less yield, as per the design doc table).
  //
  // To exclude a block from muck production, simply remove its entry.
  // Optional gating: add "requiresMod": "modid" to an entry, or use the
  // top-level wrapper form in MuckDropTable if you want to gate an entire file.
  // To add modded stone types, create a new file in this same folder.

  // ── Igneous ──────────────────────────────────────────────────────────────

  {
    "blockCode": "game:rock-granite",
    "stoneCode": "game:rock-granite",
    "stoneLayers": {
      "avg": 6,
      "var": 1,
      "dist": "UNIFORM"
    }
  },
  {
