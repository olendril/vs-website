[
	// ── IME Muck Drop Table — Vanilla Ore Blocks ─────────────────────────────
	// Ore block code format: game:ore-{quality}-{orename}-{hostrock}
	// Wildcards only support a trailing *, so we use one entry per quality tier
	// per ore, with the host rock wildcarded: game:ore-poor-nativecopper-*
	//
	// Layer counts per quality (Design Doc §2.2):
	//   poor:      1 ore layer
	//   medium:    2 ore layers
	//   rich:      3 ore layers
	//   bountiful: 4 ore layers
	// All tiers also produce 2±1 stone layers.
	//
	// Add more ores by copying a block of 4 entries and changing the ore name.
	// Unusual naming (e.g. quartz_nativegold) still follows the same format.
	// Optional gating: add "requiresMod": "modid" to any entry, or switch to
	// the top-level wrapper form if you want to gate the whole file.

	// ── Nativecopper ─────────────────────────────────────────────────────────

	{
		blockCode: "game:ore-poor-nativecopper-*",
		oreCode: "game:ore-nativecopper",
