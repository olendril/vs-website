[
{
	//For wooden tankards with leather binding 
	ingredientPattern: "HC,LW",
	ingredients: {
		"H": { type: "item", code: "game:hammer-*", isTool: true, toolDurabilityCost: 5},
		"C": { type: "item", code: "game:chisel-*", isTool: true, toolDurabilityCost: 5},
		"L": { type: "item", code: "game:leather-normal-*", name: "binding", allowedVariants: ["plain", "red", "gray", "black", "white", "pink", "purple", "yellow", "blue", "green", "orange"]},
		"W": { type: "block", code: "game:log-placed-*-ud", name: "wood", allowedVariants: ["oak", "birch", "pine", "acacia", "aged", "larch", "baldcypress", "ebony", "kapok", "maple", "purpleheart", "redwood", "walnut"]},
	},
	width: 2,
	height: 2,
	output: { type: "block", code: "tankard-woodtype-{wood}.-leather-{binding}", quantity: 1},	
},
{
