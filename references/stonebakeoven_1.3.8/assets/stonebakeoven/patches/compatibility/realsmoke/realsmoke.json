  // Controller Adding RealSmoke
  {
    "side": "server",
    "dependsOn": [ { "modid": "realsmoke" } ],
    "file": "stonebakeoven:blocktypes/ovencontrollerbrick.json",
    "op": "addmerge",
    "path": "/entityBehaviors",
    "value": [
      {
        "name": "BlockEntityBehaviorRealSmokeEmitter",
        "properties": {
          "smokeProduction": 4,
          "isSmoking": "IsBurning",
          "extinguishFunction": "CoolNow",
          "temperatureFunction": "furnaceTemperature",
          "ventAbove": 1,
          "canVentSideways": false,
          "canVentFront": true
