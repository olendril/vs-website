{
	code: "decoct",
	class: "ItemLiquidPortion",
	matterState: "liquid",

	variantgroups: [
		{
			code: "base",
			states: ["coffee", "licorice"]
		},
		{
			code: "mode",
			states: ["hot", "cold"]
		}
	],

	shape: { base: "game:item/liquid" },

	texture: { base: "game:block/liquid/waterportion" },
	textureByType: {
		"*-coffee-*": { base: "steepandbrew:block/liquid/decoct-coffee" },
		"*-licorice-*": { base: "steepandbrew:block/liquid/decoct-licorice" }
	},

	maxstacksize: 5000,
	materialDensity: 200,

	guiTransform: {
		translation: { x: 0, y: 1, z: 0 },
		rotation: { x: 123, y: -33, z: -13 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 1.4
	},
	tpHandTransform: {
		translation: { x: -1.5, y: -1, z: -1.4 }
	},

	attributes: {
		handbook: { ignoreCreativeInvStacks: true },

		waterTightContainerProps: {
			containable: true,
			itemsPerLitre: 100,
			allowSpill: true,
			whenSpilled: {
				action: "DropContents",
				stack: { type: "item", code: "steepandbrew:decoct-coffee-hot" }
			},

			texturebytype: {
				"*-coffee-*": { base: "steepandbrew:block/liquid/decoct-coffee" },
				"*-licorice-*": { base: "steepandbrew:block/liquid/decoct-licorice" }
			},

			nutritionPropsPerLitre: {
				satiety: 0,
				foodcategory: "NoNutrition",
				satietyByType: {
					"*-coffee-hot": 5,
					"*-coffee-cold": 5,
					"*-licorice-hot": 15,
					"*-licorice-cold": 15
				},
				healthByType: {
					"*-licorice-hot": 1,
					"*-licorice-cold": 1
				}
			}
		},

		// HoD attribute contract: top-level under attributes (NOT inside waterTightContainerProps).
		hydration: 0,
		hydrationByType: {
			"*-coffee-hot": 850,
			"*-coffee-cold": 900,
			"*-licorice-hot": 500,
			"*-licorice-cold": 650
		},

		coolingByType: {
			"*-coffee-cold": 1,
			"*-licorice-cold": 1
		},

		HoDisBoilingByType: { "*-hot": true },
		warmthBoostByType: {
			"*-hot": 1
		},

		// Read by TeaEffectsOnDrinkPatch — same effect framework tea uses.
		steepandbrewPropsByType: {
			"*-coffee-hot": { walkSpeed: { mag: 0.1, sec: 300 } },
			"*-coffee-cold": { walkSpeed: { mag: 0.1, sec: 300 } },
			"*-licorice-hot": { hungerRate: { mag: -0.1, sec: 300 } },
			"*-licorice-cold": { hungerRate: { mag: -0.1, sec: 300 } }
		}
	},

	transitionablePropsByType: {
		"*-coffee-hot": [{ type: "Perish", freshHours: { avg: 24 }, transitionHours: { avg: 48 }, transitionedStack: { type: "item", code: "game:rot" }, transitionRatio: 0.005 }],
		"*-coffee-cold": [{ type: "Perish", freshHours: { avg: 168 }, transitionHours: { avg: 48 }, transitionedStack: { type: "item", code: "game:rot" }, transitionRatio: 0.005 }],
		"*-licorice-hot": [{ type: "Perish", freshHours: { avg: 336 }, transitionHours: { avg: 48 }, transitionedStack: { type: "item", code: "game:rot" }, transitionRatio: 0.005 }],
		"*-licorice-cold": [{ type: "Perish", freshHours: { avg: 576 }, transitionHours: { avg: 48 }, transitionedStack: { type: "item", code: "game:rot" }, transitionRatio: 0.005 }]
	},

	creativeinventory: { "general": ["*"] }
}
