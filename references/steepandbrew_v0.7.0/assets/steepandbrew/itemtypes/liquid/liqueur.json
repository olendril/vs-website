{
	code: "liqueur",
	class: "ItemLiquidPortion",
	matterState: "liquid",

	variantgroups: [
		{
			code: "name",
			states: ["chartreuse-green", "chartreuse-yellow", "coffeeliqueur"]
		}
	],

	shape: { base: "game:item/liquid" },

	texture: { base: "game:block/liquid/waterportion" },
	textureByType: {
		"*-chartreuse-green": { base: "steepandbrew:block/liquid/liqueur-chartreuse-green" },
		"*-chartreuse-yellow": { base: "steepandbrew:block/liquid/liqueur-chartreuse-yellow" },
		"*-coffeeliqueur": { base: "steepandbrew:block/liquid/liqueur-coffeeliqueur" }
	},

	maxstacksize: 5000,
	materialDensity: 200,

	guiTransform: {
		translation: { x: 0, y: 1, z: 0 },
		rotation: { x: 123, y: -33, z: -13 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 1.4
	},
	tpHandTransform: {
		translation: { x: -1.5, y: -1, z: -1.4 }
	},

	attributes: {
		handbook: { ignoreCreativeInvStacks: true },

		waterTightContainerProps: {
			containable: true,
			itemsPerLitre: 100,
			allowSpill: true,
			whenSpilled: {
				action: "DropContents",
				stack: { type: "item", code: "steepandbrew:liqueur-chartreuse-green" }
			},

			texturebytype: {
				"*-chartreuse-green": { base: "steepandbrew:block/liquid/liqueur-chartreuse-green" },
				"*-chartreuse-yellow": { base: "steepandbrew:block/liquid/liqueur-chartreuse-yellow" },
				"*-coffeeliqueur": { base: "steepandbrew:block/liquid/liqueur-coffeeliqueur" }
			},

			// Alcoholic liqueur: per-variant intoxication + baked themed effects.
			nutritionPropsPerLitre: {
				satiety: 0,
				foodcategory: "NoNutrition",
				intoxicationByType: {
					"*-chartreuse-green": 0.7,
					"*-chartreuse-yellow": 0.5,
					"*-coffeeliqueur": 0.4
				},
				satietyByType: {
					"*-chartreuse-green": 10,
					"*-chartreuse-yellow": 25,
					"*-coffeeliqueur": 10
				}
			}
		},

		hydration: 0,
		hydrationByType: {
			"*-chartreuse-green": 300,
			"*-chartreuse-yellow": 350,
			"*-coffeeliqueur": 200
		},

		warmthBoostByType: {
			"*-coffeeliqueur": 1
		},

		// Read by TeaEffectsOnDrinkPatch (stability / regen / walk speed).
		steepandbrewPropsByType: {
			"*-chartreuse-green": { stabilityGain: 0.2, regenRate: { mag: 0.25, sec: 20 } },
			"*-chartreuse-yellow": { stabilityGain: 0.08, regenRate: { mag: 0.1, sec: 15 } },
			"*-coffeeliqueur": { walkSpeed: { mag: 0.12, sec: 300 } }
		}
	},

	transitionablePropsByType: {
		"*-chartreuse-green": [{ type: "Perish", freshHours: { avg: 8760 }, transitionHours: { avg: 48 }, transitionedStack: { type: "item", code: "game:rot" }, transitionRatio: 0.005 }],
		"*-chartreuse-yellow": [{ type: "Perish", freshHours: { avg: 8760 }, transitionHours: { avg: 48 }, transitionedStack: { type: "item", code: "game:rot" }, transitionRatio: 0.005 }],
		"*-coffeeliqueur": [{ type: "Perish", freshHours: { avg: 8760 }, transitionHours: { avg: 48 }, transitionedStack: { type: "item", code: "game:rot" }, transitionRatio: 0.005 }]
	},

	creativeinventory: { "general": ["*"] }
}
