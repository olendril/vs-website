{
	"code": "cartsign",

	"variantgroups": [

		{
			"code": "type",
			"states": [
				"slim",
				"wide",
				"single"
			]
		},

		{
			"code": "wood",
			"states": [ "aged" ],
			"loadFromProperties": "game:block/wood"
		},
		{
			"code": "background",
			"states": [
				"cloth",
				"wood",
				"glass"
			]
		},
		{
			"code": "overlay",
			"states": [
				"berry",
				"book",
				"bread",
				"charcoal",
				"hide",
				"ingot",
				"rawmeat",
				"rustygear",
				"sewingkit",
				"temporalgear",

				"anvil",
				"pickaxe",
				"cabbage",
				"wheel",
				"hammer",
				"falx",
				"brick",
				"bandage",
				"axe",
				"orechunk"
			]
		}
	],
	"skipVariants": [
		"*-aged"
	],
	"allowedVariants": [
		"cartsign-single-oak-*"
	],
	"attributesByType": {
		"*": {
			"attachableToEntity": {
				"texturePrefixCode": "",
				"categoryCodeByType": {
					"*": "cartpostextra"
				},
				"attachedShapeBySlotCodeByType": {
					"*": {
						"*-slimcar*": { "base": "item/sign/post-slim" },
						"*-smallstal*": { "base": "item/sign/post-single" },
						"*sled*": { "base": "item/sign/post-sled" },
						"*torage*": { "base": "item/sign/post-inventory" },
						"*": { "base": "item/sign/post-wide" }
					}
				}
			}
		}
	},
	"behaviorsByType": {
		"*": [
			{ "name": "GroundStorable" }
		]
	},
	"shapeByType": {
		"*": { "base": "item/sign/post-inventory" }
	},
	"texturesByType": {
		"*": {
			"clothbase": { "base": "signs/{background}" },
			"signoverlay": { "base": "signs/overlay/{overlay}" },
			"oak-h": { "base": "game:block/wood/bark/{wood}-h" },
			"iron": { "base": "game:block/metal/lantern/iron" },
			"mordant2": { "base": "game:block/cloth/pelt" },
			"mordant": { "base": "game:block/cloth/linen/mordant" },
			"quartzglass": { "base": "game:block/glass/vintage" }
		}
	},
	"heldTpIdleAnimationByType": {
		"*": "holdbothhands"
	},
	"maxStackSize": 32,
	"creativeinventory": {
		"general": [ "*" ],
		"cartwrightscaravan": [ "*" ]
	},
	"renderAlphaTest": 0.25,
	"guiTransformByType": {
		"*":{
			"translation": {
				"x": 8,
				"y": -4,
				"z": 0
			},
			"rotation": {
				"x": -120,
				"y": 90,
				"z": 52
			},
			"origin": {
				"x": 0.56,
				"y": 0.1,
				"z": 0.4899
			},
			"scaleXyz": {
				"x": -2.1,
				"y": 2.1,
				"z": 2.1
			}
		}
	}

}	


