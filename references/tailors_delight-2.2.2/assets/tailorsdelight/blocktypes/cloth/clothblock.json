{
	"code": "clothblock",
	"class": "Block",
	"shape": { "base": "game:block/basic/cube" },
	"drawtype": "Cube",
	"attributes": {
		"canChisel": true,
		"handbook": { "groupBy": [ "clothblock-*" ] },
		"mapColorCode": "settlement"
	},
	"variantgroups": [
		{ "code": "pattern", "states": [ "none", "checker" ] },
		{ "code": "color", "states": [ "plain", "black", "blue", "brown", "gray", "green", "orange", "pink", "purple", "red", "yellow", "white", "darkblue", "darkbrown", "darkgreen", "darkred" ] },
		{ "code": "stitches", "states": [ "none" ] }
	],
	"blockmaterial": "Cloth",
	"creativeinventory": { "general": ["*"],  "decorative": ["*"] },
	"replaceable": 700,
	"resistance": 1.5,
	"lightAbsorption": 99,
	"texturesByType": {
		"@^clothblock-none-dark.*": {
			"all": {
				"base": "tailorsdelight:block/cloth/dark/{color}",
				"blendedOverlays": [
					{ "base": "tailorsdelight:overlays/stitches_dark", "blendMode": "Darken" },
					{ "base": "tailorsdelight:overlays/stitches_light", "blendMode": "Lighten" }
				]
			}
		},
		"@^clothblock-checker-dark.*": {
			"all": {
				"base": "tailorsdelight:block/cloth/dark/{color}",
				"blendedOverlays": [ { "base": "tailorsdelight:overlays/checker_2x2", "blendMode": "Overlay" }
				]
			}
		},
		"clothblock-none-*": {
			"all": {
				"base": "game:block/cloth/linen/{color}",
				"blendedOverlays": [
					{ "base": "tailorsdelight:overlays/stitches_dark", "blendMode": "Darken" },
					{ "base": "tailorsdelight:overlays/stitches_light", "blendMode": "Lighten" }
				]
			}
		},
		"clothblock-checker-*": {
			"all": {
				"base": "game:block/cloth/linen/{color}",
				"blendedOverlays": [ { "base": "tailorsdelight:overlays/checker_2x2", "blendMode": "Overlay" }
				]
			}
		}
	},
	"heldTpIdleAnimation": "holdbothhandslarge", "heldTpUseAnimation": "twohandplaceblock",
	"tpHandTransform": {
		"translation": { "x": -1.23, "y": -0.91, "z": -0.8 },
		"rotation": { "x": -2, "y": 25, "z": -78 },
		"scale": 0.4
        },
	"combustibleProps": {
		"burnTemperature": 400,
		"burnDuration": 30
	},
	"sounds": {
		"place": "game:block/cloth",
		"break": "game:block/cloth",
		"hit": "game:block/cloth",
		"walk": "game:block/cloth"
	},
	"materialDensity": 300
}
