{
	"code": "buttons",
	"__comment": "ItemNugget is to display yield in tooltip, dimensions and storage flags to make them to into the crucible",
	"classByType": {
		"@^buttons-(copper|brass|gold|silver|zinc)": "ItemNugget"
	},
        "dimensionsByType": {
		"@^buttons-(copper|brass|gold|silver|zinc)": { "width": 0.0625, "height": 0.0625, "length": 0.0625 }
	},
        "storageFlagsByType": {
		"@^buttons-(copper|brass|gold|silver|zinc)": 5
	},
	"attributes": {
		"displaycaseable": true,
		"shelvable": true,
		"onDisplayTransform": {
			"translation": { "x": -0.02, "y": 0, "z": 0 },
			"rotation": { "x": 0, "y": -45, "z": 0 },
			"origin": { "x": 0.5, "y": 0, "z": 0.5 },
			"scale": 0.8
		},
		"onShelfTransform": {
			"translation": { "x": 0, "y": -0.1, "z": 0 },
			"scale": 0.8
		},
		"handbook": {
			"extraSections": [ { "title": "game:handbook-item-usage", "text": "tailorsdelight:handbook-item-buttons" } ]
		}
	},
	"behaviors": [
                { "name": "GroundStorable", "properties": { "layout": "Quadrants", "collisionBox": { "x1": 0, "y1": 0, "z1": 0, "x2": 1, "y2": 0.0625, "z2": 1 } } }
	],
	"variantgroups": [
		{ "code":"type", "states": [ "mixed", "horn", "copper", "brass", "gold", "silver", "zinc", "emerald", "lapislazuli", "shells" ] }
	],
	"creativeinventory": { "general": ["*"], "items": ["*"] },
	"maxstacksize": 16,
	"materialDensity": 350,
	"grindingPropsByType": {
		"buttons-shells": {
			"groundStack": { "type": "item", "code": "game:lime", "stacksize": 3 }
		}
	},
	"crushingPropsByType": {
		"buttons-lapislazuli": {
			"crushedStack": { "type": "item", "code": "game:crushed-lapislazuli", "stacksize": 4 }, "hardnessTier": 2
                }
	},
	"combustiblePropsByType": {
		"buttons-copper":	{ "meltingPoint": 1084, "meltingDuration": 30, "smeltedRatio": 4, "smeltedStack": { "type": "item", "code": "game:ingot-copper" } },
		"buttons-brass":	{ "meltingPoint":  920, "meltingDuration": 30, "smeltedRatio": 4, "smeltedStack": { "type": "item", "code": "game:ingot-brass" } },
		"buttons-gold":		{ "meltingPoint": 1063, "meltingDuration": 30, "smeltedRatio": 4, "smeltedStack": { "type": "item", "code": "game:ingot-gold" } },
		"buttons-silver":	{ "meltingPoint":  961, "meltingDuration": 30, "smeltedRatio": 4, "smeltedStack": { "type": "item", "code": "game:ingot-silver" } },
		"buttons-zinc":		{ "meltingPoint":  419, "meltingDuration": 30, "smeltedRatio": 4, "smeltedStack": { "type": "item", "code": "game:ingot-zinc" } }
	},
	"shapeByType": {
		"@^buttons-(mixed|horn|zinc)": { "base": "tailorsdelight:item/resource/buttons" },
		"buttons-gold": { "base": "tailorsdelight:item/resource/buttons_sparkly" },
		"*": { "base": "tailorsdelight:item/resource/buttons_shiny" }
	},
	"vertexFlagsByType": {
		"@^buttons-(mixed|horn|zinc)": { },
		"buttons-gold": { "reflectiveMode": 3 },
		"*": { "reflectiveMode": 2 }
        },
	"texturesByType": {
		"buttons-mixed": {
			"bone": { "base": "game:block/creature/bone-yellow" },
			"horn": { "base": "game:block/creature/bonesrotten" },
			"wood": { "base": "game:item/tool/handle" }
		},
		"buttons-horn": {
			"bone": { "base": "tailorsdelight:item/horn-dark" },
			"horn": { "base": "tailorsdelight:item/horn-light" },
			"wood": { "base": "game:block/creature/bonesrotten" }
		},
		"buttons-shells": {
			"bone": { "base": "game:block/creature/aquatic/seashell/turquoise" },
			"horn": { "base": "game:block/creature/aquatic/seashell/seafoam" },
			"wood": { "base": "game:block/creature/aquatic/seashell/cinnamon" }
		},
		"@^buttons-(emerald|lapislazuli)": {
			"bone": { "base": "game:block/stone/gem/{type}" },
			"horn": { "base": "game:block/stone/gem/{type}" },
			"wood": { "base": "game:block/stone/gem/{type}" }
		},
		"buttons-zinc": {
			"bone": { "base": "game:block/metal/plate/zinc" },
			"horn": { "base": "game:block/metal/plate/steel" },
			"wood": { "base": "game:block/metal/ingot/iron" }
		},
		"*": {
			"bone": { "base": "game:block/metal/ingot/{type}" },
			"horn": { "base": "game:block/metal/ingot/{type}" },
			"wood": { "base": "game:block/metal/ingot/{type}" }
		}
	},
	"guiTransform": {
		"translation": { "x": 2, "y": 3, "z": 0 },
		"rotation": { "x": -166, "y": 78, "z": -45 },
		"origin": { "x": 0.5, "y": 0.05, "z": 0.5 },
		"scale": 2.5
	},
	"tpHandTransform": {
		"translation": { "x": -1, "y": -0.9, "z": -1.35 },
		"rotation": { "x": 99, "y": -180, "z": 180 },
		"scale": 0.49
	},
	"groundTransform": {
		"translation": { "x": 0, "y": 0.25, "z": 0 },
		"rotation": { "x": 0, "y": 0, "z": 0 },
		"origin": { "x": 0.5, "y": 0.31, "z": 0.5299 },
		"scale": 4
	}
}
