---
interface Props {
  videoId: string;
  title: string;
}

const { videoId, title } = Astro.props;

if (!videoId.trim()) {
  throw new Error('VideoEmbed requires a YouTube video ID.');
}

if (!title.trim()) {
  throw new Error('VideoEmbed requires a meaningful title.');
}
---

<div class="video-embed">
  <iframe
    src={`https://www.youtube.com/embed/${encodeURIComponent(videoId)}`}
    title={title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen></iframe>
</div>

<style>
  .video-embed {
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    margin-block: 1.5rem;
    overflow: hidden;
  }

  .video-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
